{
    "name": "honk/honk",
    "description": "Official PHP client for Honk! Honk! (honk-honk.app): send events from apps, scripts and automations to your phone. Laravel facade, queued sends and notification channel included.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "honk",
        "honk-honk",
        "notifications",
        "push",
        "push-notifications",
        "alerts",
        "laravel",
        "notification-channel",
        "monitoring",
        "sdk"
    ],
    "homepage": "https://github.com/honk-hq/php",
    "support": {
        "issues": "https://github.com/honk-hq/php/issues",
        "source": "https://github.com/honk-hq/php"
    },
    "authors": [
        {
            "name": "Honk contributors",
            "homepage": "https://honk-honk.app"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-curl": "Used by default to talk to Honk! Honk! (or pass any PSR-18 client).",
        "laravel/framework": "Facade, Honk::fake(), queue/defer sends, the notification channel, exception reporting and scheduler hooks (Laravel 13)."
    },
    "conflict": {
        "laravel/framework": "<13.0",
        "illuminate/support": "<13.0"
    },
    "autoload": {
        "psr-4": {
            "Honk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Honk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Honk\\Laravel\\HonkServiceProvider"
            ],
            "aliases": {
                "Honk": "Honk\\Laravel\\Facades\\Honk"
            }
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit,laravel",
        "test:integration": "phpunit --testsuite integration",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
